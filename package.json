{
  "name": "desoworks-academy",
  "productName": "DesoWorks Academy",
  "version": "0.3.0",
  "private": true,
  "description": "Eigenständige Academy-Plattform von DesoWorks mit neutralem Core und installierbaren Lernmodulen",
  "author": "DesoWorks",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist:dir": "electron-builder --win dir",
    "dist:nsis": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.desoworks.academy",
    "productName": "DesoWorks Academy",
    "copyright": "DesoWorks",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "channel.json",
      "build/icon.png",
      "build/build-info.json"
    ],
    "extraResources": [
      {
        "from": "modules",
        "to": "academy-modules"
      },
      {
        "from": "catalog",
        "to": "academy-catalog"
      },
      {
        "from": "module-template",
        "to": "academy-module-template"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DesoWorks Academy",
      "artifactName": "DesoWorks-Academy-Setup-${version}.${ext}",
      "uninstallDisplayName": "DesoWorks Academy",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
